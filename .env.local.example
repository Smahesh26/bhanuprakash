# ===============================================
# DATABASE CONFIGURATION
# ===============================================
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database?ssl=true
DATABASE_URL=postgresql://user:password@localhost:5432/bhanuprakash?sslmode=require&schema=public

# ===============================================
# NEXTAUTH CONFIGURATION
# ===============================================
# The URL where your app is deployed (used by NextAuth for callbacks)
# Local: http://localhost:3000
# Production: https://your-domain.com
NEXTAUTH_URL=http://localhost:3000

# Secret key for NextAuth session encryption (minimum 32 characters)
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-here-minimum-32-characters-long

# ===============================================
# EMAIL CONFIGURATION (Choose ONE)
# ===============================================

# Option 1: SendGrid (recommended for production)
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here

# Option 2: NodeMailer (Gmail or other SMTP)
# Get Gmail App Password: https://myaccount.google.com/apppasswords
NODEMAILER_EMAIL=your-email@gmail.com
NODEMAILER_PASSWORD=your-gmail-app-password

# ===============================================
# STRIPE CONFIGURATION
# ===============================================
# Get keys from: https://dashboard.stripe.com/apikeys
# Use pk_test_* and sk_test_* for development
# Use pk_live_* and sk_live_* for production

# Stripe publishable key (public, safe to expose)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Stripe secret key (keep private!)
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Webhook signing secret
# Found in Stripe Dashboard > Webhooks > Signing Secret
# Local: Use tunnel service or configure webhook in Stripe dashboard
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ===============================================
# CLOUDINARY CONFIGURATION
# ===============================================
# Get credentials from: https://cloudinary.com/console

# Your Cloudinary cloud name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Cloudinary API key
CLOUDINARY_API_KEY=your-api-key-here

# Cloudinary API secret (keep private!)
CLOUDINARY_API_SECRET=your-api-secret-here

# ===============================================
# ENCRYPTION CONFIGURATION
# ===============================================
# 32-character key for encrypting Stripe secrets in database
# Generate: openssl rand -hex 16 (produces 32 hex characters)
ENCRYPTION_KEY=your-32-character-encryption-key-here

# ===============================================
# FEATURE FLAGS (Optional)
# ===============================================
# Enable email verification during signup
EMAIL_VERIFICATION_ENABLED=true

# Enable payment processing
STRIPE_ENABLED=true

# Enable image uploads to Cloudinary
IMAGE_UPLOAD_ENABLED=true

# ===============================================
# DEVELOPMENT CONFIGURATION (Optional)
# ===============================================
# Set to 'development' or 'production'
NODE_ENV=development

# Enable debug logging
DEBUG=false

# ===============================================
# SETUP INSTRUCTIONS
# ===============================================
# 1. Copy this file to .env.local
# 2. Replace all placeholder values with actual credentials
# 3. Do NOT commit .env.local to version control
# 4. Ensure .env.local is in .gitignore
# 
# For local development:
# - Use test credentials (Stripe pk_test_*, sk_test_*)
# - Use a local PostgreSQL database or Render's free tier
# - Use SendGrid free tier or Gmail SMTP
#
# For production:
# - Use live credentials only
# - Ensure all secrets are properly configured
# - Use environment variables in deployment platform
#   (Render, Vercel, etc.)
